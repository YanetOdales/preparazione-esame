# Required runtime settings
OPENROUTER_API_KEY=your-openrouter-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_USER_ID=your-telegram-user-id
OPENCODE_API_URL=http://opencode:4096
OPENCODE_MODEL_PROVIDER=openrouter
OPENCODE_MODEL_ID=google/gemini-3.6-flash
TELEGRAM_BOT_LOCALE=it
EXAM_RESULTS_PATH=/data/esami

# Host bind-mounts
HOST_TELEGRAM_DATA_DIR=./data/telegram
HOST_RESULTS_DIR=./data/esami
HOST_OPENCODE_WORKSPACE_DIR=./data/opencode/workspace
HOST_OPENCODE_ROOT_DIR=./data/opencode/root
HOST_AGENTS_DIR=../.agents
